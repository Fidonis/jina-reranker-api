# Local development configuration for `uv run python main.py`.
# Copy this file to src/.env and adjust. src/.env is gitignored.

# --- Inbound auth (optional) ---
# When set, clients MUST send: Authorization: Bearer <API_KEY>.
# Leave empty to leave the endpoint open (no inbound auth).
API_KEY=

# --- Reranker backend (OpenAI-compatible: LiteLLM, vLLM, …) ---
RERANKER_BASE_URL=http://localhost:4000
RERANKER_API_KEY=
RERANKER_MODEL=rerank-english-v3.0

# --- Server ---
PORT=8000
LOG_LEVEL=INFO
# Hard cap on the number of documents forwarded to the rerank backend.
# LiteLLM enforces a maximum of 1024; set lower to reduce backend load.
MAX_RERANK_DOCS=1024
# Timeout in seconds for outgoing requests to the rerank backend.
# Increase for slow or large models (default: 60).
BACKEND_TIMEOUT=60
