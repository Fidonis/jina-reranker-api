# Environment for docker/docker-compose.yml.
# Copy this file to docker/.env and fill in real values.
# docker/.env is gitignored and MUST NOT be committed.

# --- Inbound auth (optional) ---
# When set, clients MUST send: Authorization: Bearer <API_KEY>.
# Leave empty to leave the endpoint open (no inbound auth).
API_KEY=

# --- Reranker backend (OpenAI-compatible: LiteLLM, vLLM, …) ---
RERANKER_BASE_URL=http://litellmproxy:4000
RERANKER_API_KEY=
RERANKER_MODEL=deepinfra/qwen3-reranker-8b

# --- Server ---
PORT=8000
LOG_LEVEL=INFO
